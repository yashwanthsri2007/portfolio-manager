# ============================================================
# Portfolio Manager — Environment Variables Template
# ============================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# On Vercel: add these under Settings → Environment Variables.
# NEVER commit .env.local or any file with real API keys to Git.
# ============================================================

# ── Google Gemini AI ─────────────────────────────────────────
# Obtain at: https://aistudio.google.com/app/apikey
# Server-side fallback when no key is entered in app Settings.
GEMINI_API_KEY=

# ── Finnhub Stock Market Data ─────────────────────────────────
# Obtain at: https://finnhub.io/register
# Free tier: 60 API calls/minute; NSE/BSE quotes available.
FINNHUB_API_KEY=

# ── Angel One SmartAPI ────────────────────────────────────────
# Obtain at: https://smartapi.angelone.in/
# Server-side fallback for Angel One proxy routes.
ANGEL_ONE_API_KEY=

# ── Firebase (Client-side — safe to include in frontend) ──────
# These VITE_ prefixed variables are bundled into the frontend.
# Security is enforced by Firestore Security Rules, NOT by hiding these keys.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Notes ─────────────────────────────────────────────────────
# Keys for Groq, NVIDIA NIM, and Bytez are entered by users in
# the app's AI Provider Settings page and stored in localStorage.
# They are forwarded via request headers to backend proxy routes
# and are never persisted server-side.
